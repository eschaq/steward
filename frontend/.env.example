# Firebase web app config — `firebase apps:sdkconfig WEB --project steward-hackathon-505217`.
# These are browser-side values, public by design in any Firebase web app; the
# Security Rules and the backend's token checks are what actually protect data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Where the backend is. Leave BLANK for local development, including reaching
# the app from a phone on the same network: the app then talks to whatever host
# you browsed from, on port 8000. Hardcoding localhost here breaks phone access,
# because on the phone localhost is the phone.
# Set it only when the backend lives somewhere else — e.g. its Cloud Run URL.
VITE_API_BASE_URL=

# The estate the dashboard shows. One estate per session for now.
VITE_ESTATE_ID=seed-estate-001
