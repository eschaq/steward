# Gemini API key from AI Studio (https://ai.studio/apikey) — direct Gemini API,
# not Vertex AI. Copy to .env and fill in. .env is gitignored.
GEMINI_API_KEY=

# Optional — defaults to gemini-3.5-flash. Flash by default; Pro is reserved for
# complex final reasoning.
# GEMINI_MODEL=gemini-3.5-flash
